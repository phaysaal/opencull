-- Protect then reveal: one photograph, developed in steps.
--
-- Not a suggestion. The program writes a recipe, renders it, measures
-- what it did, looks at its own result, and revises -- within a budget,
-- because a photographer does not give one frame infinite time. Every
-- round is written to disk before the next one starts: as evidence that
-- the process did what it claims, and because round two is sometimes the
-- better photograph.
--
-- The method is the darkroom's, and Adams' after it: decide first what
-- cannot be saved, refuse to spend the print trying, and do the work
-- everywhere else.
--
-- The loop stops two ways. The critique says the treatment is finished,
-- which is the cheap and usual one; or the budget runs out, which is
-- there for the frame where it never is.

param photos: text = "."
param photo: text = ""
param output: text = "treatment.json"
param spectrum: text = "visible"
param cutoff_nm: num = 0
param about: text = ""
param rounds: num = 3
param proof_edge: num = 1400

use "agents.kim"
use python "treatment_kernel.py"

context k_treatment:
    domain = "professional photographic development by staged reasoning"
    preserve = [subject_identity, irrecoverable_facts, stated_strategy, measured_evidence]
    allow_loss = [wording, slider_precision]

schema Plan:
    subject: text
    condition: text
    irrecoverable: text
    protect: text
    reveal: text
    title: text
    strategy: text
    -- Whether this photograph wants developing at all. A frame that
    -- already serves its subject should be left alone, and no is a
    -- professional answer.
    needs_edit: bool
    -- Why: what is wrong that an edit can fix, or what was examined and
    -- found already right.
    verdict: text
    -- How many regions of this frame need opposite things. Zero is a
    -- real answer and the usual one.
    mask_count: num
    -- The whole-frame moves, as a JSON object of named numbers.
    global_adjustments: text
    -- The contract: which measured numbers should move and which way,
    -- as a JSON object like {"veil_percent": "down"}. The round offered
    -- at the end is the one that meets these.
    goals: text
    rationale: text

schema Mask:
    region: text
    purpose: text
    shape: text
    centre_x: num
    centre_y: num
    radius: num
    anchor: text
    inverted: bool
    feather: num
    -- What happens inside it, as a JSON object of named numbers.
    adjustments: text

schema Critique:
    improved: text
    regressed: text
    next_change: text
    finished: bool
    rationale: text

stamp := now_stamp()
directory := treatment_directory(photos, photo, stamp)

-- The frame with nothing done to it, through the renderer every round
-- will use. Anchoring the loop anywhere else -- an export from another
-- pipeline, however good -- makes the two engines' disagreement look
-- like damage the round did, and the critique spends the budget asking
-- for a correction that was never the problem.
origin := starting_frame(photos, photo, directory, proof_edge)
evidence := evidence_json(photo, origin, spectrum, cutoff_nm, about)

start := observe image(origin)
check start.exists
untouched := measure_frame_json(origin)

-- What the planner is shown. Round one this is the untouched frame;
-- after that, the latest render -- a reviser that has never seen the
-- picture it is revising can only repeat what the critique told it,
-- and the critique itself compares both frames side by side.
latest := start

critique := ""
records := []
forall attempt in range(rounds):
    if check keep_going(records, rounds):
        -- One plan: the diagnosis, what to protect and reveal, the moves
        -- for the whole frame, and how many regions need separating.
        -- What is already in force. A round revises the last one; read
        -- as a fresh recipe, "leave the whole frame unchanged" arrives
        -- as an empty answer and the frame springs back to untouched.
        standing := standing_moves(records, untouched)
        plan := memo gen<Plan>(plan_prompt(evidence, critique, standing), images=[latest]) by A
        check keep_plan(directory, records, plan)

        -- The branch. Most photographs answer zero and the loop below
        -- never runs; this one is asked about each region on its own.
        -- The gate, asked before anything is spent. A photograph that
        -- already serves its subject is offered as it stands: an earlier
        -- shape had no way to say so, and on a frame that arrived well
        -- exposed it edited three times and finished with a posterised
        -- sky and the roofline it promised to protect gone.
        if check edit_wanted(plan, records):
            -- A mask that does not arrive is skipped, not fatal. One live
            -- run lost a whole treatment -- the plan, the render, the
            -- budget -- because one answer came back missing a field.
            masks := []
            forall index in range(mask_count(plan)):
                mask := memo gen<Mask>(mask_prompt(evidence, plan, index, mask_count(plan), masks), images=[start]) by A
                if check keep_mask(directory, records, masks, mask):
                    masks := masks + [mask]

            -- Assembled here from numbers, not written as prose and hoped
            -- to compile: a live round once produced two operations out of
            -- a page of intent, and three produced none at all.
            recipe := assemble_recipe(photo, plan, masks, standing)
            if check treatment_usable(recipe):
                -- What each mask will actually touch, measured from the
                -- renderer's own weights before the render is paid for.
                -- The gap between "a gradient over the rooftop" and a
                -- ramp at half strength over the sky lived here, unseen,
                -- for nine runs.
                placed := measure_masks(origin, recipe)
                render := render_round(photos, photo, recipe, directory, records, proof_edge)
                measured := measure_frame_json(render)
                proof := observe image(render)
                check proof.exists
                critique := memo gen<Critique>(critique_prompt(evidence, plan, measured, round_number(records), rounds, placed), images=[start, proof]) by B
                records := records + [round_record(directory, records, recipe, plan, render, measured, critique, placed)]
                latest := proof
            else:
                records := records + [round_record(directory, records, recipe, plan)]
        else:
            records := records + [left_alone_record(directory, records, plan, origin, untouched)]

check len(records) > 0
chosen := best_round(records, untouched)

-- Every round on one sheet, so the argument the loop had with itself
-- can be looked at without opening six files.
sheet := contact_sheet(directory, records, chosen)
check len(sheet) > 0
report := treatment_report(directory, photo, evidence, records, chosen)
check treatment_valid(report)
warrant := treatment_evidence(report)

-- The rounds are already on disk; what is warranted here is the finished
-- treatment: that it did what it said it would, protected what it said
-- was irrecoverable, and is offering the round it measured best.
if memo judge<5,4/5> (warrant |= treatment_policy(evidence)) under k_treatment panel [C, D]:
    act file.overwrite(output, report)
    settle until check file_exists(output) within 5
    commit(report)
else:
    -- An abstention keeps its evidence, and the rounds stay on disk: the
    -- work is still there to look at even when nobody will vouch for it.
    refusal := treatment_abstention(warrant)
    check len(refusal) > 0
    act file.overwrite(output + ".abstained.txt", refusal)
    abstain
